/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */
	// DEFINIÇÃO DE VARIÁVEIS
	uint32_t tempo_atual = HAL_GetTick();
	uint32_t tempo_anterior = tempo_atual;
	uint32_t timeON_0 = tempo_atual;
	uint32_t timeON_D1_1 = tempo_atual, timeOFF_D1_1 = tempo_atual, timeON_D2_1 = tempo_atual;
	uint32_t tempo500 = tempo_atual;
	uint32_t timeON_UserLed = tempo_atual, timeOFF_UserLed = tempo_atual;

	// Variável para salvar o tempo
	int	estado_atual = 0, estado_anterior=0, estado_leds=0;		// Variáveis para salvar os estados
	int	sequencia=1;											// Auxiliar para o terceiro caso
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  /* USER CODE BEGIN 2 */

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */


  while (1)
  {
	  // A função HAL_GetTick() retorna o tempo atual em milissegundos
	  // desde o início da execução do microcontrolador
	  uint32_t tempo_atual = HAL_GetTick();		// Variável para contar o tempo

	  // Variáveis locais para ler o valor de cada botão
	  int SW1 = HAL_GPIO_ReadPin(pino0_GPIO_Port, pino0_Pin);	// Botão 1
	  int SW2 = HAL_GPIO_ReadPin(pino1_GPIO_Port, pino1_Pin);	// Botão 2


	  // IDENTIFICAÇÃO DO ESTADO
	  if (SW1==GPIO_PIN_SET && SW2==GPIO_PIN_SET){
		  estado_atual=0;	// Nenhum botão pressionado: define o estado 0

	  } else if (SW1==GPIO_PIN_RESET && SW2==GPIO_PIN_SET){
	  	  estado_atual=1;	// Apenas botão 1 pressionado: define o estado 1

	  } else if (SW1==GPIO_PIN_SET && SW2==GPIO_PIN_RESET){
	   	  estado_atual=2;	// Apenas botão 2 pressionado: define o estado 2

	  } else if (SW1==GPIO_PIN_RESET && SW2==GPIO_PIN_RESET){
	  	  estado_atual=3;	// Dois botões pressionados: define o estado 4
	  }


	  // REINÍCIO DO SISTEMA
 	  if (estado_atual != estado_anterior){	// Verifica se o estado mudou

   	      sequencia = 1;
  	      estado_leds = 0;

          HAL_GPIO_WritePin(led1_GPIO_Port, led1_Pin, GPIO_PIN_SET);
          HAL_GPIO_WritePin(led2_GPIO_Port, led2_Pin, GPIO_PIN_SET);
          HAL_GPIO_WritePin(led3_GPIO_Port, led3_Pin, GPIO_PIN_SET);
          HAL_GPIO_WritePin(led4_GPIO_Port, led4_Pin, GPIO_PIN_SET);

          estado_anterior = estado_atual;	// Atualiza o estado
  	   }

 	  // DELAY NÃO BLOCANTE
 	  	 //não contém contadores, é utilizado lógicas de comparação do tempo atual e anterior.
       	  switch (estado_atual){

       	  	  case 0:	// LEDs D1-D4 piscando todos com o mesmo valor a cada 500 ms

       	  		  // DEFINIÇÃO DO INTERVALO DE TEMPO
       	  		  // O valor escolhido deve ser múltiplo de 100ms
       	  		// Tempo simétrico para acender e apagar os LEDs

       	  		  if ((tempo_atual-timeON_0)>=500){		// Verifica se passou o tempo desejado
       	  			  if (estado_leds == 0) {	// Caso esteja apagado, acende
       		  			  estado_leds = 1;		// GPIO_PIN_SET
       	  			  } else {					// Caso esteja aceso, apaga
       	  				  estado_leds = 0;		// GPIO_PIN_RESET
       	  			  }
       	  			  HAL_GPIO_WritePin(led1_GPIO_Port, led1_Pin, estado_leds);	// "Escreve" o estado no D1
       		  		  HAL_GPIO_WritePin(led2_GPIO_Port, led2_Pin, estado_leds);	// "Escreve" o estado no D2
       		  		  HAL_GPIO_WritePin(led3_GPIO_Port, led3_Pin, estado_leds);	// "Escreve" o estado no D3
       		  		  HAL_GPIO_WritePin(led4_GPIO_Port, led4_Pin, estado_leds);	// "Escreve" o estado no D4
       				  timeON_0=tempo_atual;		// Reseta o tempo anterior
       	  		  }
   		          break;

       	  	  case 1:
       	  		  // LEDs D1 e D3 devem piscar 100 ms acessos, 500 ms apagados; e
       	  		  // D2 e D4 devem piscar 300 ms apagados, 300 ms acesos (nessa ordem)

       	  		  // DEFINIÇÃO DOS INTERVALOS DE TEMPO
       	  		  // atribuição do tempo atual para as constantes de tempo a serem comparadas.

       	  		  // LEDs 1 e 3
       	  		  if (HAL_GPIO_ReadPin(led1_GPIO_Port, led1_Pin) == GPIO_PIN_SET){ // Se LED1 apagado
       	  			  if ((tempo_atual-timeOFF_D1_1)>=100) {	// Verifica se passou o tempo desejado
       	  				  HAL_GPIO_WritePin(led1_GPIO_Port, led1_Pin, GPIO_PIN_RESET);	// Acende D1
       	  				  HAL_GPIO_WritePin(led3_GPIO_Port, led3_Pin, GPIO_PIN_RESET);	// Acende D3
       	  	              timeOFF_D1_1 = tempo_atual;		// atualiza o tempo anterior
                      }
       	  		  } else { 	// Se D1 aceso
       	  			  if ((tempo_atual-timeON_D1_1)>=500) {	// Verifica se passou o tempo desejado
       	  				  HAL_GPIO_WritePin(led1_GPIO_Port, led1_Pin, GPIO_PIN_SET);	// Apaga D1
       	  				  HAL_GPIO_WritePin(led3_GPIO_Port, led3_Pin, GPIO_PIN_SET);	// Apaga D3
       	  				  timeON_D1_1 = tempo_atual;		// reseta o tempo anterior
       	  	          }
       	  	      }

       	  		  // LEDs 2 e 4
       	  		  if ((tempo_atual-timeON_D2_1)>=300) {	// Verifica se passou o tempo desejado
       	  			  HAL_GPIO_TogglePin(led2_GPIO_Port, led2_Pin);		// Inverte o valor do D2
       	  		  	  HAL_GPIO_TogglePin(led4_GPIO_Port, led4_Pin);		// Inverte o valor do D4
       	  		  	  timeON_D2_1 = tempo_atual;		// reseta o tempo anterior
       	  		  }
       	  		  break;

       	  	case 2:	// Apenas um led deve ficar acesso a cada 500 milissegundos,
       	  		  		  	  	// seguindo a ordem: D1 → D2 → D3 → D4 → D1 ...

       	  		// DEFINIÇÃO DO INTERVALO DE TEMPO
       	  		// O valor escolhido deve ser múltiplo de 100ms

       	  		if (tempo_atual-tempo500 >= 500) {	// Verifica se passou o tempo desejado

       	  		  		        // DEFINE A SEQUÊNCIA DE ACENDIMENTO DOS LEDs
					if (sequencia==1) {	// A sequência foi definida como 1, então começa aqui
						HAL_GPIO_WritePin(led1_GPIO_Port, led1_Pin, GPIO_PIN_RESET); // Acende D1
						HAL_GPIO_WritePin(led2_GPIO_Port, led2_Pin, GPIO_PIN_SET);
						HAL_GPIO_WritePin(led3_GPIO_Port, led3_Pin, GPIO_PIN_SET);
						HAL_GPIO_WritePin(led4_GPIO_Port, led4_Pin, GPIO_PIN_SET);
						sequencia=2;	// A sequência prossegue

					} else if (sequencia==2) {
						HAL_GPIO_WritePin(led2_GPIO_Port, led2_Pin, GPIO_PIN_RESET); // Acende D2
						HAL_GPIO_WritePin(led1_GPIO_Port, led1_Pin, GPIO_PIN_SET);
						HAL_GPIO_WritePin(led3_GPIO_Port, led3_Pin, GPIO_PIN_SET);
						HAL_GPIO_WritePin(led4_GPIO_Port, led4_Pin, GPIO_PIN_SET);
						sequencia=3;

					} else if (sequencia==3) {
						HAL_GPIO_WritePin(led3_GPIO_Port, led3_Pin, GPIO_PIN_RESET); // Acende D3
						HAL_GPIO_WritePin(led1_GPIO_Port, led1_Pin, GPIO_PIN_SET);
						HAL_GPIO_WritePin(led2_GPIO_Port, led2_Pin, GPIO_PIN_SET);
						HAL_GPIO_WritePin(led4_GPIO_Port, led4_Pin, GPIO_PIN_SET);
						sequencia=4;

					} else if (sequencia==4) {
						HAL_GPIO_WritePin(led4_GPIO_Port, led4_Pin, GPIO_PIN_RESET); // Acende D4
						HAL_GPIO_WritePin(led1_GPIO_Port, led1_Pin, GPIO_PIN_SET);
						HAL_GPIO_WritePin(led2_GPIO_Port, led2_Pin, GPIO_PIN_SET);
						HAL_GPIO_WritePin(led3_GPIO_Port, led3_Pin, GPIO_PIN_SET);
						sequencia=1;	// Reinicia a sequência
					}

					tempo500 = tempo_atual;		// Reseta o tempo anterior
       	  		}
       	  		break;

       	  	  case 3:	// Caso não pré-definido, a escolha foi acender todos os LEDs
       	  		  HAL_GPIO_WritePin(led1_GPIO_Port, led1_Pin, GPIO_PIN_RESET); // Acende D1
       	  	      HAL_GPIO_WritePin(led2_GPIO_Port, led2_Pin, GPIO_PIN_RESET); // Acende D2
      	  	      HAL_GPIO_WritePin(led3_GPIO_Port, led3_Pin, GPIO_PIN_RESET); // Acende D3
       	  	      HAL_GPIO_WritePin(led4_GPIO_Port, led4_Pin, GPIO_PIN_RESET); // Acende D4
       	  	      break;

       	  	  default:	// Caso ocorra algum erro
       	  	      estado_atual = 0;		// Retorna ao estado inicial
       	  	      break;
       	  } // Fim do switch
       	  // CONTROLE DA USERLED DA BLUEPILL
       	  // Definição dos intervalos de tempo
       	  	  if (HAL_GPIO_ReadPin(UserLed_GPIO_Port, UserLed_Pin)==GPIO_PIN_SET){	// Se apagado
       	  		  if ((tempo_atual-timeOFF_UserLed)>=1900){	// Verifica se passou o tempo desejado
       	  			  HAL_GPIO_WritePin(UserLed_GPIO_Port, UserLed_Pin, GPIO_PIN_RESET);	// Acende UserLed
       	  			  timeOFF_UserLed = tempo_atual;		// reseta o tempo anterior
       	  		  }
       	  	  } else{
       	  		  if ((tempo_atual-timeON_UserLed)>=100){		// Verifica se passou o tempo desejado
       	  			  HAL_GPIO_WritePin(UserLed_GPIO_Port, UserLed_Pin, GPIO_PIN_SET);	// Apaga UserLed
       	  			  timeON_UserLed = tempo_atual;		// Reseta o tempo anterior
       	  		  }
       	  	  }

	  }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */


