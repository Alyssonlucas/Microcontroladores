/**
  * @brief  Unidade lógica principal que gerencia o fluxo global e a Máquina de Estados do jogo Genius.
  * @note   A rotina consome as entradas estáveis de tempo e joystick, aplicando ações e atualizando o OLED internamente.
  * @param  time_now: Registro temporal instantâneo capturado via HAL_GetTick().
  * @param  direcao: Estado atual de posicionamento angular do joystick obtido do periférico.
  * @param  jogo: Ponteiro direcionado para a estrutura de dados persistentes do motor do jogo.
  * @param  last_oled_update: Ponteiro para a variável de controle temporal dedicada do display OLED.
  * @retval None
  */
void Gerenciar_Genius(uint32_t time_now, Joystick_Dir direcao, GeniusGame *jogo, uint32_t *last_oled_update) {

    // Processamento das transições e ações baseadas no estado atual da FSM
    switch (jogo->estado) {

        case AGUARDANDO_INICIO:
            Joystick_diretions(JOY_CENTER); // Desativação completa dos canais de áudio e do LED RGB corporativo

            // Avaliação assíncrona da flag de comando produzida pela interrupção do botão externo
            if (condition_check_key() == START) {

                srand(HAL_GetTick()); // Semeadura do gerador matemático pseudoaleatório com base no tempo de boot
                jogo->nivel = 1; // Redefinição do nível inicial da rodada
                jogo->sequencia[0] = AdicionarCorNaSequencia(jogo->nivel); // Sorteio e inserção do elemento primário na sequência
                jogo->passo = 0; // Inicialização do indexador de passos do vetor
                jogo->jogada_avaliada = 0; // Desbloqueio da flag de monitoramento de jogadas do usuário
                jogo->estado = MOSTRANDO_SEQUENCIA; // Transição para a rotina de sinalização da sequência gerada
                jogo->mostrando_nota = 0; // Ajuste do sub-estado inicial para acionamento visual do LED indicador
                Reset_Flag_key(); // Consumo explícito do evento de interrupção para evitar múltiplas transições falsas
            }
            break;

        case MOSTRANDO_SEQUENCIA:
            if (jogo->mostrando_nota == 0) {
                // Etapa 0: Ativação dos estímulos sonoros e luminosos correspondentes ao passo atual da sequência
                Joystick_diretions(jogo->sequencia[jogo->passo]);
                jogo->tempo = time_now; // Gravação do marco temporal inicial do pulso visual
                jogo->mostrando_nota = 1; // Deslocamento para sub-estado de monitoramento de desligamento do elemento
            }
            else if (jogo->mostrando_nota == 1) {
                // Etapa 1: Manutenção da saída ativa por uma janela de tempo fixa não-blocante de 1000ms
                if (time_now - jogo->tempo >= 1000) {
                    Joystick_diretions(JOY_CENTER); // Cessação completa dos estímulos (Retorno ao repouso)
                    jogo->tempo = time_now; // Gravação do marco temporal do intervalo entre notas sucessivas
                    jogo->mostrando_nota = 2; // Deslocamento para sub-estado de controle do período de apagamento
                }
            }
            else if (jogo->mostrando_nota == 2) {
                // Etapa 2: Sustentação de intervalo desligado por 250ms para desambiguação de termos homogêneos sucessivos
                if (time_now - jogo->tempo >= 250) {
                    jogo->passo++; // Incremento do ponteiro do indexador de passos

                    // Avaliação da conclusão da amostragem total do nível vigente
                    if (jogo->passo >= jogo->nivel) {
                        jogo->passo = 0; // Reinicialização do índice de passos para o modo de captura do jogador
                        jogo->ultima_direcao = direcao; // Sincronização estática para detecção ativa de variação angular
                        jogo->estado = JOGADOR_JOGANDO; // Transição da FSM global para aguardar resposta do usuário
                        jogo->mostrando_nota = 0; // Reinicialização dos sub-estados de sinalização
                    } else {
                        jogo->mostrando_nota = 0; // Recorrência interna para apresentação da nota subsequente
                    }
                }
            }
            break;

        case JOGADOR_JOGANDO:
            Joystick_diretions(direcao); // Fornecimento de feedback visual/sonoro imediato para a manipulação corrente

            // Verificação de alteração de vetor geométrico espacial nas coordenadas do Joystick
            if (direcao != jogo->ultima_direcao) {
                jogo->ultima_direcao = direcao; // Atualização do estado anterior estável
                jogo->tempo = time_now; // Registro temporal para filtragem de histerese e transientes mecânicos
                jogo->jogada_avaliada = 0; // Liberação para o ciclo de análise lógica da jogada efetuada
            }

            // Filtragem temporal e estabilização de leitura (Debounce estático de posição fixado em 150ms)
            if (direcao != JOY_CENTER && (time_now - jogo->tempo >= 150)) {

                // Execução do escopo crítico de testes lógicos apenas uma vez por transição estável
                if (jogo->jogada_avaliada == 0) {
                    Joystick_diretions(direcao); // Ativação direta dos periféricos associados

                    // Validação estrutural de equivalência geométrica entre a ação efetuada e o registro do padrão
                    if (direcao == jogo->sequencia[jogo->passo]) {
                        jogo->passo++; // Deslocamento para o exame do passo subsequente

                        // Validação de correspondência total de toda a cadeia mapeada para o nível corrente
                        if (jogo->passo >= jogo->nivel) {
                            jogo->nivel++; // Incremento do score e complexidade algorítmica do jogo
                            jogo->sequencia[jogo->nivel - 1] = AdicionarCorNaSequencia(jogo->nivel); // Inserção de novo termo aleatório
                            jogo->estado = MOSTRANDO_SEQUENCIA; // Retorno ao ciclo automático de exibição visual
                            jogo->passo = 0; // Reinicialização do cursor indexador
                            jogo->mostrando_nota = 0; // Reinicialização dos sub-estados temporizadores
                        }
                    } else {
                        // Desvio estrutural indicando erro por parte do operador humano
                        jogo->estado = GAME_OVER; // Redirecionamento imediato da FSM global
                        jogo->tempo = time_now; // Coleta do tempo absoluto do evento de erro
                        RGB_SetColor(1000, 0, 0); // Ativação forçada do código de luz vermelho de falha
                        Buzzer_PlayTone(100); // Emissão de tom grave dissonante indicativo de erro
                    }
                    jogo->jogada_avaliada = 1; // Retenção do sinalizador para evitar reentrância no processamento analógico
                }
            }
            else if (direcao == JOY_CENTER) {
                Joystick_diretions(JOY_CENTER); // Desativação dos canais caso o comando tenha retornado ao centro estável
            }
            break;

        case GAME_OVER:
            // Bloqueio temporizado não-blocante por 2000ms para exibição da tela estática de fim de jogo
            if (time_now - jogo->tempo >= 2000) {
                Buzzer_Stop(); // Interrupção do sinal de áudio analógico continuado
                Joystick_diretions(JOY_CENTER); // Apagamento geral das matrizes luminosas RGB
                Reset_Flag_key(); // Limpeza preventiva secundária para purga de dados acumulados por interrupções espúrias
                jogo->estado = AGUARDANDO_INICIO; // Transição cíclica para reestabelecimento da rotina inicial
            }
            break;
    }

    // Integração Direta: Atualização síncrona imediata da interface gráfica com base nas mudanças internas da FSM
    WriteOled(time_now, last_oled_update, jogo->nivel, direcao, jogo->estado);
}

/**
  * @brief  Gerencia o ciclo de oscilação simétrica do LED de atividade do sistema de forma paralela.
  * @note   Promove um padrão assimétrico não-blocante (Duty Cycle visível de pulsação curta).
  * @param  time_now: Registro temporal instantâneo capturado via HAL_GetTick().
  * @param  time_UserLed: Ponteiro para o acumulador estático de controle do intervalo temporal do LED.
  * @retval None
  */
void UserLed(uint32_t time_now, uint32_t *time_UserLed)
{
    // Verificação do estado elétrico do pino de saída digital do LED de atividade
    if (HAL_GPIO_ReadPin(UserLed_GPIO_Port, UserLed_Pin) == GPIO_PIN_SET)
    {
        // Temporização estendida para o estado desligado/repouso (1950ms)
        if ((time_now - *time_UserLed) >= 1950) {
            HAL_GPIO_WritePin(UserLed_GPIO_Port, UserLed_Pin, GPIO_PIN_RESET);
            *time_UserLed = time_now;
        }
    } else {
        // Temporização restrita para o estado ativo de disparo visual rápido (50ms)
        if ((time_now - *time_UserLed) >= 50) {
            HAL_GPIO_WritePin(UserLed_GPIO_Port, UserLed_Pin, GPIO_PIN_SET);
            *time_UserLed = time_now;
        }
    }
}

/**
  * @brief  Modulador de hardware periférico para alteração de PWM cromático e tons harmônicos do buzzer.
  * @note   Aplica otimização de filtro de entrada executando comandos exclusivamente mediante variação de estado discreto.
  * @param  direcao: Enumeração contendo a coordenada espacial sob processamento elétrico.
  * @retval None
  */
void Joystick_diretions(Joystick_Dir direcao){
	static Joystick_Dir ultimaDirecao = JOY_CENTER; // Variável estática retentiva local de memória

    // Aplicação do filtro para eliminação de acessos repetitivos concorrentes aos registradores de hardware
    if (direcao != ultimaDirecao)
    {
        ultimaDirecao = direcao;

        // Comutação e atribuição direta dos limites PWM correspondentes ao perfil físico escolhido
        switch(direcao)
        {
            case JOY_UP:
                RGB_SetColor(0, 1000, 0); // Perfil Cromático: Verde
                Buzzer_PlayTone(440); // Frequência Harmônica: Nota Lá (A4)
                break;

            case JOY_DOWN:
                RGB_SetColor(0, 0, 1000); // Perfil Cromático: Azul
                Buzzer_PlayTone(440);
                break;

            case JOY_LEFT:
                RGB_SetColor(1000, 0, 0); // Perfil Cromático: Vermelho
                Buzzer_PlayTone(440);
                break;

            case JOY_RIGHT:
                RGB_SetColor(1000, 1000, 0); // Perfil Cromático: Amarelo
                Buzzer_PlayTone(440);
                break;

            case JOY_UP_RIGHT:
                RGB_SetColor(0, 1000, 1000); // Perfil Cromático: Ciano
                Buzzer_PlayTone(440);
                break;

            case JOY_UP_LEFT:
                RGB_SetColor(200, 0, 800); // Perfil Cromático: Roxo
                Buzzer_PlayTone(440);
                break;

            case JOY_DOWN_RIGHT:
                RGB_SetColor(1000, 1000, 1000); // Perfil Cromático: Branco Absoluto
                Buzzer_PlayTone(440);
                break;

            case JOY_DOWN_LEFT:
                RGB_SetColor(1000, 0, 300); // Perfil Cromático: Rosa
                Buzzer_PlayTone(440);
                break;

            case JOY_CENTER:
            default:
                RGB_SetColor(0, 0, 0); // Extinção cromática total
                Buzzer_Stop(); // Suspensão imediata da modulação do oscilador PWM piezoelétrico
                break;
        }
    }
}

/**
  * @brief  Varre e escreve strings textuais dinâmicas nas páginas lógicas de exibição do display OLED.
  * @note   Filtra chamadas através de uma janela de restrição temporal fixa de 50ms associada à verificação de prontidão do I2C.
  * @param  time_now: Registro temporal instantâneo de execução.
  * @param  last_oled_update: Ponteiro para o registro estático persistente do ciclo anterior.
  * @param  nivel_atual: Valor numérico correspondente à pontuação corrente interna obtida.
  * @param  direcao: Vetor posicional do joystick sob amostragem estrutural de feedback.
  * @param  estado: Token identificador da Máquina de Estados operante do jogo.
  * @retval None
  */
void WriteOled(uint32_t time_now, uint32_t *last_oled_update, uint8_t nivel_atual, Joystick_Dir direcao, Estado_Jogo estado)
{
    // Controle adaptativo não-blocante da taxa de quadros e atualização física do display (Janela de 50ms)
    if (time_now - *last_oled_update >= 50) {

        // Proteção e tratamento de exceção preventiva para validação de disponibilidade física do barramento I2C
        if (HAL_I2C_GetState(&hi2c1) == HAL_I2C_STATE_READY) {
            OLED_Clear(); // Limpeza completa do buffer de renderização local

            // Inserção da string estática do cabeçalho fixo estrutural do projeto
            OLED_DrawString(40, 5, "GENIUS");

            // Seleção e montagem da tela de exibição contextualizada com base no estado lógico do sistema
            switch (estado) {

                case AGUARDANDO_INICIO:
                    OLED_DrawString(35, 25, "START GAME");
                    OLED_DrawString(15, 45, "Aperte o Botao");
                    break;

                case MOSTRANDO_SEQUENCIA:
                    char buffer_nivel[20];
                    sprintf(buffer_nivel, "Nivel: %d", nivel_atual); // Conversão formatada para string dinamicamente
                    OLED_DrawString(10, 25, buffer_nivel);
                    OLED_DrawString(10, 45, "PRESTE ATENCAO");
                    break;

                case JOGADOR_JOGANDO:
                    char buffer_jogando[20];
                    sprintf(buffer_jogando, "Nivel: %d", nivel_atual);
                    OLED_DrawString(10, 25, buffer_jogando);

                    // Mapeamento e decodificação do string descritivo de feedback do pino analógico do Joystick
                    char* texto_cor = "Sua vez...";
                    switch (direcao) {
                         case JOY_UP:          texto_cor = "VERDE";        break;
                         case JOY_DOWN:        texto_cor = "AZUL";         break;
                         case JOY_LEFT:        texto_cor = "VERMELHO";     break;
                         case JOY_RIGHT:       texto_cor = "AMARELO";      break;
                         case JOY_UP_RIGHT:    texto_cor = "CIANO";        break;
                         case JOY_UP_LEFT:     texto_cor = "ROXO";         break;
                         case JOY_DOWN_RIGHT:  texto_cor = "BRANCO";       break;
                         case JOY_DOWN_LEFT:   texto_cor = "ROSA";         break;
                         case JOY_CENTER:      texto_cor = "Jogue logo...";break;
                         default:              texto_cor = "Jogue logo...";break;
                    }
                    OLED_DrawString(10, 45, texto_cor);
                    break;

                case GAME_OVER:
                    OLED_Clear(); // Limpeza adicional preventiva do buffer local para centralização da mensagem
                    OLED_DrawString(35, 25, "GAME OVER");

                    char buffer_score[20];
                    sprintf(buffer_score, "Pontos: %d", nivel_atual - 1); // Cálculo aritmético do score real do usuário
                    OLED_DrawString(35, 45, buffer_score);
                    break;
            }

            OLED_Update(); // Transmissão serial do buffer lógico para o controlador integrado do display via barramento I2C
            *last_oled_update = time_now; // Renovação da variável de marcação do ciclo temporal
        }
    }
}

/**
  * @brief  Aplica o operador módulo aritmético sobre o retorno do gerador randômico para obtenção de coordenadas discretas.
  * @note   Divide a roleta matemática de amostragem uniformemente entre as 8 direções mapeadas do joystick.
  * @param  nivel: Parâmetro inteiro indicando o nível numérico atual sob incremento.
  * @retval Joystick_Dir: Enumeração correspondente à direção do joystick adicionada à sequência.
  */
Joystick_Dir AdicionarCorNaSequencia(uint8_t nivel){
    // Ajuste restrictivo de intervalo da imagem numérica pseudoaleatória para o espaço de 0 a 7
    uint8_t sorteio = rand() % 8;

    // Vinculação biunívoca entre os números inteiros indexados e os tokens discretos das direções
    switch(sorteio) {
        case 0:  return(JOY_UP);         // Verde
        case 1:  return(JOY_DOWN);       // Azul
        case 2:  return(JOY_LEFT);       // Vermelho
        case 3:  return(JOY_RIGHT);      // Amarelo
        case 4:  return(JOY_UP_RIGHT);   // Ciano
        case 5:  return(JOY_UP_LEFT);    // Roxo
        case 6:  return(JOY_DOWN_RIGHT); // Branco
        case 7:  return(JOY_DOWN_LEFT);  // Rosa
        default: return(JOY_CENTER);
    }
}
