  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  /* USER CODE BEGIN 2 */

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  tempo_atual = HAL_GetTick();

	  if(condition_check_key1() == START)
	  {
		  //Código de tratamento da interrupção
		  	//Chama uma função://Pisca o LED D3 com o padrão 50 ms acesso, 150 ms apagado por 3 segundos;

		  if(tempo_atual-time_LED3<=3000)
		  {
			  if(tempo_atual-time_LED3_150>=150)
			  {
				  HAL_GPIO_WritePin(GPIOx, GPIO_Pin, PinState);

			  }
		  }
		  //Reseta a flag:
		  else if(tempo_atual-time_LED3>=3000)
		  {
		  Reset_Flag_key1();
		  }
	  }
	  if(condition_check_key2() == START)
	  {
	  		  //Código de tratamento da interrupção
		  	  //Pisca o LED D4 com o padrão 100 ms acesso, 500 ms apagado por 6 segundos;
	  		  //Reseta a flag:
	  		Reset_Flag_key2();
	  }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

