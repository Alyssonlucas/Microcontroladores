void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin) //Função Callback: Serve para chamar uma interrupção externa
{

	/* Verifica se a interrupção foi gerada pelo pino do SW01 */
	  if (GPIO_Pin == pino0_Pin) //Se interrupção do botão 1 pressionado -> inverte led e seta flag do botão 1
	  {
	    /* Inverte o estado do LED D1 */
	    HAL_GPIO_TogglePin(led1_GPIO_Port, led1_Pin);
	    Set_Flag_key1();
	  }

	  /* Verifica se a interrupção foi gerada pelo pino do SW2 */
	  else if (GPIO_Pin == pino1_Pin) //Se interrupção do botão 1 pressionado -> inverte led e seta flag do botão 1
	  {
	    /* Inverte o estado do LED D2 */
	    HAL_GPIO_TogglePin(led2_GPIO_Port, led2_Pin);
	    Set_Flag_key2();
	  }
}

void Estado_LED4(uint32_t tempo_atual, uint32_t *timeD1_1, uint32_t *timeON_D2_1)
{
    // LED 4: 100 ms aceso, 500 ms apagado por 6 segundos
    if (HAL_GPIO_ReadPin(led1_GPIO_Port, led1_Pin) == GPIO_PIN_SET) { // Se apagados
        if ((tempo_atual - *timeD1_1) >= 500) {
            HAL_GPIO_WritePin(led4_GPIO_Port, led4_Pin, GPIO_PIN_RESET);
            *timeD1_1 = tempo_atual;
        }
    } else { // Se aceso
        if ((tempo_atual - *timeD1_1) >= 100) {
            HAL_GPIO_WritePin(led4_GPIO_Port, led4_Pin, GPIO_PIN_SET);
            *timeD1_1 = tempo_atual;
        }
    }
}


void UserLed(uint32_t tempo_atual, uint32_t *time_UserLed)
{
    if (HAL_GPIO_ReadPin(UserLed_GPIO_Port, UserLed_Pin) == GPIO_PIN_SET) { // Se apagado
        if ((tempo_atual - *time_UserLed) >= 1900) {
            HAL_GPIO_WritePin(UserLed_GPIO_Port, UserLed_Pin, GPIO_PIN_RESET);
            *time_UserLed = tempo_atual;
        }
    } else { // Se aceso
        if ((tempo_atual - *time_UserLed) >= 100) {
            HAL_GPIO_WritePin(UserLed_GPIO_Port, UserLed_Pin, GPIO_PIN_SET);
            *time_UserLed = tempo_atual;
        }
    }
}


