//Função Callback: Serve para chamar uma interrupção externa
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{

	/* Verifica se a interrupção foi gerada pelo pino do SW01 */
	//interrupção do botão 1 (pressionado) -> Inverte led1 e Seta Flag1

	  if (GPIO_Pin == pino0_Pin)
	  {
		/* Inverte o estado do LED D1 */
	    HAL_GPIO_TogglePin(led1_GPIO_Port, led1_Pin);
	   //Seta a Flag1.
	    Set_Flag_key1();
	  }

	  /* Verifica se a interrupção foi gerada pelo pino do SW02 */
	  //interrupção do botão 2 (pressionado) -> Inverte led2 e Seta Flag2
	  else if (GPIO_Pin == pino1_Pin)
	  {
	    /* Inverte o estado do LED D2 */
	    HAL_GPIO_TogglePin(led2_GPIO_Port, led2_Pin);
	    //Seta a Flag2.
	    Set_Flag_key2();
	  }

}

void Estado_LED3(uint32_t tempo_atual, uint32_t *time3, uint32_t *time3seg)
{
	if ((tempo_atual - *time3seg) <=3000) //Pisca o Led3 por 3 segundos.
	{
		// LED 3: 50 ms aceso, 150 ms apagado por 3 segundos
		if (HAL_GPIO_ReadPin(led3_GPIO_Port, led3_Pin) == GPIO_PIN_SET)
		{ // Se apagado
			if ((tempo_atual - *time3) >= 150)
			{ //Espera 150ms apagado para acender.
				HAL_GPIO_WritePin(led3_GPIO_Port, led3_Pin, GPIO_PIN_RESET);
				*time3 = tempo_atual; //reseta a contagem do time3
			}
		} else
		{ // Se aceso
			if ((tempo_atual - *time3) >= 50)
			{ //espera 50ms aceso para apagar.
				HAL_GPIO_WritePin(led3_GPIO_Port, led3_Pin, GPIO_PIN_SET);
				*time3 = tempo_atual; //reseta a contagem do time3
			}
		}
	} else 	//Quando passar os 3 segundos reseta a flag1
	{
		HAL_GPIO_WritePin(led3_GPIO_Port, led3_Pin, GPIO_PIN_SET); // Garante que o led3 termine apagado
		Reset_Flag_key1();
	}
}

void Estado_LED4(uint32_t tempo_atual, uint32_t *time4, uint32_t *time6seg)
{
	if ((tempo_atual - *time6seg) <=6000) //Pisca o Led3 por 6 segundos.
	{
		// LED 4: 100 ms aceso, 500 ms apagado por 6 segundos
		if (HAL_GPIO_ReadPin(led4_GPIO_Port, led4_Pin) == GPIO_PIN_SET)
		{ // Se apagado
			if ((tempo_atual - *time4) >= 500)
			{ //Espera 500ms apagado para acender.
				HAL_GPIO_WritePin(led4_GPIO_Port, led4_Pin, GPIO_PIN_RESET);
				*time4 = tempo_atual; //reseta a contagem do time4
			}
		} else
		{ // Se aceso
			if ((tempo_atual - *time4) >= 100)
			{ //espera 100ms aceso para apagar.
				HAL_GPIO_WritePin(led4_GPIO_Port, led4_Pin, GPIO_PIN_SET);
				*time4 = tempo_atual; //reseta a contagem do time4
			}
		}
	} else //Quando passar os 6 segundos reseta a flag2
	{
		Reset_Flag_key2();
		HAL_GPIO_WritePin(led4_GPIO_Port, led4_Pin, GPIO_PIN_SET); // Garante que o led4 termine apagado
	}
}


void UserLed(uint32_t tempo_atual, uint32_t *time_UserLed)
{
    if (HAL_GPIO_ReadPin(UserLed_GPIO_Port, UserLed_Pin) == GPIO_PIN_SET) // Se apagado
    {
        if ((tempo_atual - *time_UserLed) >= 1950)
        {
            HAL_GPIO_WritePin(UserLed_GPIO_Port, UserLed_Pin, GPIO_PIN_RESET);
            *time_UserLed = tempo_atual;
        }
    } else // Se aceso
    {
        if ((tempo_atual - *time_UserLed) >= 50)
        {
            HAL_GPIO_WritePin(UserLed_GPIO_Port, UserLed_Pin, GPIO_PIN_SET);
            *time_UserLed = tempo_atual;
        }
    }
}


