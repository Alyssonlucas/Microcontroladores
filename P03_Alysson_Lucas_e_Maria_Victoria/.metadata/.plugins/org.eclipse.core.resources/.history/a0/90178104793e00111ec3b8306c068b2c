/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  uint32_t tempo_atual = HAL_GetTick(); // Atualiza o tempo atual em milissegundos

  uint32_t time3 = 0, time3seg = 0; //Controlar o tempo Led3

  uint32_t time4 = 0, time6seg = 0; //Controlar o tempo Led4

  uint32_t time_UserLed = tempo_atual; //Controlar o tempo do Userled.

  uint8_t executando_flag1 = 0, executando_flag2 = 0; // Variaveis para travar a captura do tempo


  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  /* USER CODE BEGIN 2 */

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  tempo_atual = HAL_GetTick(); // Atualiza o tempo atual em milisegundos.

	  //Função Userled. Pisca periodicamente 50ms acesso e 1950ms apagado.
	  UserLed(tempo_atual, &time_UserLed);

	  // Check da flag do botão 1
	  if(condition_check_key1() == START) //Se o botão 1 foi pressionado FLAG1 = 1.
	  {

		  // Captura o tempo inicial apenas na primeira vez que entra aqui
		  if(executando_flag1 == 0)
		  {
              time3seg = tempo_atual;
		      time3 = tempo_atual;
		      executando_flag1 = 1; // Trava para não atualizar mais
		  }
		  //Código de tratamento da interrupção
		   //Pisca o LED D3 com o padrão 50 ms acesso, 150 ms apagado por 3 segundos;
		   //Quando passar os 3 segundos a Flag1 é resetada.
		  	Estado_LED3(tempo_atual, &time3, &time3seg);
		  //Fim do código de tratamento da interrupção
	  } else
	  {
		  executando_flag1 = 0; // Prepara para a próxima vez que apertar o botão
	  }


	  // Check da flag do botão 2
	  if(condition_check_key2() == START)
	  {

		  // Captura o tempo inicial apenas na primeira vez que entra aqui
		  if(executando_flag2 == 0)
		  {
              time6seg = tempo_atual;
		      time4 = tempo_atual;
		      executando_flag2 = 1; // Trava para não atualizar mais
		  }
		  //Código de tratamento da interrupção
		  //Pisca o LED D4 com o padrão 100 ms acesso, 500 ms apagado por 6 segundos;
	  	  //Quando passar os 6 segundos a Flag2 é resetada.
		  Estado_LED4(tempo_atual, &time4, &time6seg);
		  //Fim do código de tratamento da interrupção
	  } else
	  {
		  executando_flag2 = 0; // Prepara para a próxima vez que apertar o botão
	  }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

